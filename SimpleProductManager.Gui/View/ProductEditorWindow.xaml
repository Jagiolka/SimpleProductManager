<Window x:Class="SimpleProductManager.Gui.View.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleProductManager.Gui.View"
        xmlns:viewModels="clr-namespace:SimpleProductManager.Gui.ViewModel"
        xmlns:converter="clr-namespace:SimpleProductManager.Gui.Converter"
        
        mc:Ignorable="d"
        Title="ProductEditorWindow" MinHeight="400" MaxHeight="400" MinWidth="550" MaxWidth="550"
        d:DataContext="{d:DesignInstance viewModels:ProductEditorViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="35" />
            <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="15" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="30" />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>

        <Label Grid.Row="1" Grid.Column="1" Content="SimpleProductId" />
        <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding EditingSimpleProductModel.Id}" IsReadOnly="True" />
        
        <Label Grid.Row="2" Grid.Column="1" Content="Name" />
        <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding EditingSimpleProductModel.Name, UpdateSourceTrigger=PropertyChanged}"  />
        
        <Label Grid.Row="3" Grid.Column="1" Content="Beschreibung" />
        <TextBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding EditingSimpleProductModel.Description, UpdateSourceTrigger=PropertyChanged}"  />
        
        <Label Grid.Row="4" Grid.Column="1" Content="Preis" />
        <TextBox Grid.Row="4" Grid.Column="2">
            <TextBox.Text>
                <Binding Path="EditingSimpleProductModel.Price" UpdateSourceTrigger="PropertyChanged">
                    <Binding.Converter>
                        <converter:PriceFormatConverter />
                    </Binding.Converter>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <Label Grid.Row="4" Grid.Column="3" Content="€" />
        
        <Label Grid.Row="5" Grid.Column="1" Content="Kategorien" />        
        <ComboBox Grid.Row="5" Grid.Column="2" Name="ComboBoxProductCategories"
                  ItemsSource="{Binding ProductCategories, UpdateSourceTrigger=PropertyChanged}" 
                  SelectedItem="{Binding SelectedProductCategory, UpdateSourceTrigger=PropertyChanged}" 
                  DisplayMemberPath="Name" 
                  Text="{Binding SelectedStringName, UpdateSourceTrigger=PropertyChanged}"
                  VerticalAlignment="Center"
                  IsEditable="True" Margin="0,3,0,3" />
        
        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="2">
            <Button Content="+"
                    VerticalAlignment="Center" Margin="5"
                    Style="{StaticResource ButtonStandard}"
                    Command="{Binding AddCategoryCommand}"
                    CommandParameter="{Binding SelectedStringName}" />
            <!-- Grid.Row="5" Grid.Column="3" -->
            
            <Button Content="-"
                    VerticalAlignment="Center" Margin="5"
                    Style="{StaticResource ButtonStandard}"
                    Command="{Binding RemoveCategoryCommand}"
                    CommandParameter="{Binding SelectedProductCategory}" />
            <!-- Grid.Row="5" Grid.Column="4" -->
        </StackPanel>
        
        
        <!-- <Button Content="+" Grid.Row="5" Grid.Column="3" Height="20" VerticalAlignment="Center" Margin="2"  -->
        <!--         Command="{Binding AddCategoryCommand}"  -->
        <!--         CommandParameter="{Binding SelectedStringName}" /> -->
        <!-- <Button Content="-" Grid.Row="5" Grid.Column="4" Height="20" VerticalAlignment="Center" Margin="2"  -->
        <!--         Command="{Binding RemoveCategoryCommand}"  -->
        <!--         CommandParameter="{Binding SelectedComboBoxProductCategory}" /> -->


        <StackPanel Grid.Row="7" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern" 
                    Margin="0,2,2,2" 
                    Style="{StaticResource ButtonStandard}"
                    Command="{Binding SaveExitCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
            <Button Content="Abbrechen" 
                    Margin="2,2,0,2"
                    Style="{StaticResource ButtonStandard}"
                    Command="{Binding CancelExitCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </StackPanel>
    </Grid>
</Window>